{
    "tracker_default": {
        "type": "container",
        "background": "#00000000",
        "content": {
            "type": "dock",
            "dropshadow": true,
            "content": [
                {
                    "type": "dock",
                    "dock": "left",
                    "v_alignment": "stretch",
                    "max_width": 410,
                    "margin": "0,0,4,0",
                    "content": [
                        {
                            "type": "group",
                            "header": "Items",
                            "dock": "top",
                            "content": {
                                "type": "layout",
                                "key": "shared_item_grid_vertical"
                            }
                        },
                        {
                            "type": "group",
                            "header": "Location Options / Logic",
                            "dock": "top",
                            "content": {
                                "type": "layout",
                                "key": "setting_grid"
                            }
                        },
                        {
                            "type": "group",
                            "header": "Pinned Locations",
                            "content": {
                                "style": "wrap",
                                "type": "recentpins",
                                "orientation": "vertical",
                                "compact": true
                            }
                        }
                    ]
                },
                {
                    "type": "dock",
                    "margin": "0,0",
                    "content": [
                        {
                            "type": "layout",
                            "key": "tabbed_maps_vertical"
                        }
                    ]
                }
            ]
        }
    },
    "tracker_horizontal": {
        "type": "container",
        "background": "#00000000",
        "content": {
            "type": "dock",
            "dropshadow": true,
            "content": [
                {
                    "type": "dock",
                    "dock": "bottom",
                    "max_height": 330,
                    "margin": "0,4,0,0",
                    "content": [
                        {
                            "type": "group",
                            "header": "Items",
                            "dock": "left",
                            "margin": "0,0,3,0",
                            "content": {
                                "type": "layout",
                                "key": "shared_item_grid_horizontal"
                            }
                        },
                        {
                            "type": "group",
                            "header": "Location Options / Logic",
                            "dock": "left",
                            "content": {
                                "type": "layout",
                                "key": "setting_grid"
                            }
                        },
                        {
                            "type": "group",
                            "header": "Pinned Locations",
                            "content": {
                                "style": "wrap",
                                "type": "recentpins",
                                "orientation": "horizontal",
                                "compact": true
                            }
                        }
                    ]
                },
                {
                    "type": "dock",
                    "margin": "0,0",
                    "content": [
                        {
                            "type": "layout",
                            "key": "tabbed_maps_horizontal"
                        }
                    ]
                }
            ]
        }
    }
}