# local working folder: room sheets, the click tool, verification renders,
# and the local datapackage export
_roomsheets/

# editor / language-server config, machine specific
.luarc.json

# tool inputs, neither ours to redistribute
tools/*/_input/

# the map snapshots check_maps takes and compares against
tools/verify/_baseline/
tools/verify/_original/
tools/__pycache__/
tools/*/__pycache__/

# @napi-rs/canvas, needed only to re-render the item tiles and grid maps
tools/node_modules/

# the room adjacency graph, written by extract_map_graph.py when something
# needs it
tools/generated/map_graph.json
